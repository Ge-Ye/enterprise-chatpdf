# FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000

# Storage
UPLOAD_DIR=./app/data/uploads

# Embedding provider (Ê¾Àý: corehe/cohere/local)
EMBEDDING_PROVIDER=corehe
COREHE_API_KEY=your_corehe_api_key

# Chroma
CHROMA_DB_DIR=./app/data/chroma

# Elasticsearch
ES_HOST=http://localhost:9200
ES_INDEX=chatpdf_docs

# Reranker (cohere) 
COHERE_API_KEY=your_cohere_api_key
COHERE_RERANK_MODEL=rerank-english-v2

# Deepseek LLM endpoint (Ê¾Àý)
DEESEEK_API_URL=https://api.deepseek.example/v1/stream
DEESEEK_API_KEY=your_deepseek_api_key
