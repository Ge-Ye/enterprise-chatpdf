# Copy to .env for local runs. app/core/config.py is the only loader: process
# environment variables override values in this file, which override defaults.
# Docker does not copy .env into the image; docker-compose injects it as env.
# Do not add load_dotenv() calls to application modules.

# SiliconFlow embeddings, reranking and customs extraction (fixed provider).
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
TEXT_EXTRACT_MODEL=Qwen/Qwen2.5-32B-Instruct
VISION_EXTRACT_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Retried only when the primary vision model is reported unavailable.
VISION_EXTRACT_FALLBACK_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_MAX_IMAGE_SIDE=1280
CUSTOMS_LLM_READ_TIMEOUT=120
# Set false only when the model endpoints must go through a system proxy.
LLM_BYPASS_SYSTEM_PROXY=true
# Optional fallback key when SILICONFLOW_API_KEY is empty (only meaningful when
# SILICONFLOW_BASE_URL points to an OpenAI-compatible endpoint).
OPENAI_API_KEY=

# Optional Feishu webhook for customs review alerts (empty disables alerts).
FEISHU_WEBHOOK_URL=

# Optional Elasticsearch retrieval (disabled by default). USE_ES is the only switch.
USE_ES=false
ES_HOST=http://localhost:9200
ES_INDEX=chatpdf_docs

# API authentication (leave API_KEY empty only for local development).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send it as X-API-Key or Authorization: Bearer <key>.
# The Next.js UI calls this backend directly, so it needs the key too; prefer a
# server-side proxy/BFF instead of exposing the key through NEXT_PUBLIC_*.
API_KEY=
# Authentication is enforced whenever API_KEY is set. AUTH_REQUIRED=true also
# refuses startup when API_KEY is empty (fail closed for public deployments).
AUTH_REQUIRED=false
API_KEY_HEADER=X-API-Key
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Per-IP request limits (sliding window, in-memory per process; keep one worker
# or move the counters to a shared store when scaling out).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_CHAT_REQUESTS=20

# Upload restrictions.
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/x-pdf,application/octet-stream

# DeepSeek LLM ≈‰÷√
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
