# FastAPI 服务根地址；可填 http://localhost:8000 或带 /api 的 API 地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side Next.js API routes use this address inside Docker Compose.
# For local development, leave unset to fall back to NEXT_PUBLIC_API_BASE_URL.
# INTERNAL_API_BASE_URL=http://backend:8000
